{
  "name": "gagyebu-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --filter @gagyebu/app dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "server": "node --env-file=.env server/src/main.ts",
    "bots": "node scripts/bots.mjs --url http://localhost:8091",
    "shots": "node scripts/shots.mjs",
    "single": "node scripts/build-single.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
