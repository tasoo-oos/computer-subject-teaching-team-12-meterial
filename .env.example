# ─ 포트 체계 ─────────────────────────────────────────────────────────────
# 운영: 게임 서버가 8091에서 src/dist까지 혼자 맡는다(리버스 프록시 → 10.10.2.23:8091).
#   이 파일을 .env으로 복사해 아래 값 그대로 쓴다.
# 개발: 게임 서버는 8092, Vite(pnpm dev 5173 / dev-public 8091)가 /socket.io·/api를
#   8092로 넘긴다. .env과 같은 곳에 .env.dev를 만들어 아래 두 줄만 넣는다:
#     PORT=8092
#     NODE_ENV=development
#   그리고 `pnpm server:dev`로 띄운다(.env 위에 .env.dev 값을 덮어쓴다).
# ─────────────────────────────────────────────────────────────────────────
# HTTP·Socket.IO 포트 (§7)
PORT=8091
# 전면(TV) 비밀번호 — 필수
STAGE_PASSWORD=
# 통제(교사) 비밀번호 — 필수, STAGE_PASSWORD와 달라야 함
CONTROL_PASSWORD=
# 쿠키 서명용 무작위 문자열 — 필수, 32자 이상
COOKIE_SECRET=
# 세션 로그 루트 (gitignore 대상)
DATA_DIR=./data
# true일 때만 /solo 200
SOLO_ENABLED=false
# development면 쿠키 Secure 끔
NODE_ENV=production
# 이 주소에서 온 요청만 X-Forwarded-For 신뢰 (리버스 프록시 Nginx Proxy Guard, §12.1)
TRUSTED_PROXY=10.10.2.21
# 수업별 최대 학생 수
MAX_STUDENTS=60
# openClass의 기본 레슨
LESSON_ID=first-salary
