# HTTP·Socket.IO 포트 (§7)
PORT=8091
# 전면(TV) 비밀번호 — 필수
STAGE_PASSWORD=
# 통제(교사) 비밀번호 — 필수, STAGE_PASSWORD와 달라야 함
CONTROL_PASSWORD=
# 쿠키 서명용 무작열 문자열 — 필수, 32자 이상
COOKIE_SECRET=
# 세션 로그 루트 (gitignore 대상)
DATA_DIR=./data
# true일 때만 /solo 200
SOLO_ENABLED=false
# development면 쿠키 Secure 끔
NODE_ENV=production
# 이 주소에서 온 요청만 X-Forwarded-For 신뢰 (리버스 프록시 Nginx Proxy Guard, §12.1)
TRUSTED_PROXY=10.10.2.21
# 수업별 최대 학생 수
MAX_STUDENTS=60
# openClass의 기본 레슨
LESSON_ID=first-salary
